{
  "uid": "iiot-overview",
  "title": "IIoT Sensoren",
  "tags": ["iiot"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "group",
        "label": "Gruppe",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "influxdb" },
        "query": "import \"influxdata/influxdb/schema\"\n\nschema.tagValues(bucket: v.defaultBucket, tag: \"group\", start: -30d)",
        "definition": "schema.tagValues(group)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Bekannte Geräte (30 Tage)",
      "description": "Anzahl unterschiedlicher Gruppen mit Messwerten oder Statusmeldungen.",
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"temperature\" or r._measurement == \"humidity\" or r._measurement == \"device_status\")\n  |> last()\n  |> keep(columns: [\"group\"])\n  |> group()\n  |> distinct(column: \"group\")\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Status ok",
      "description": "Geräte, deren letzte Statusmeldung \"ok\" ist.",
      "gridPos": { "x": 5, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"device_status\" and r._field == \"status\")\n  |> last()\n  |> filter(fn: (r) => r._value == \"ok\")\n  |> group()\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "green" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Aktiv (Messwert < 10 min)",
      "description": "Gruppen mit Temperatur- oder Luftfeuchtemesswert in den letzten 10 Minuten.",
      "gridPos": { "x": 10, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -10m)\n  |> filter(fn: (r) => (r._measurement == \"temperature\" or r._measurement == \"humidity\") and r._field == \"value\")\n  |> last()\n  |> keep(columns: [\"group\"])\n  |> group()\n  |> distinct(column: \"group\")\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "orange" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ø Temperatur (Auswahl, Zeitraum)",
      "gridPos": { "x": 14, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and r._field == \"value\")\n  |> filter(fn: (r) => r.group =~ /^${group:regex}$/)\n  |> group()\n  |> mean()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "purple" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Ø Luftfeuchte (Auswahl, Zeitraum)",
      "gridPos": { "x": 19, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"humidity\" and r._field == \"value\")\n  |> filter(fn: (r) => r.group =~ /^${group:regex}$/)\n  |> group()\n  |> mean()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "humidity",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Temperatur",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 10 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and r._field == \"value\")\n  |> filter(fn: (r) => r.group =~ /^${group:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"group\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "displayName": "${__field.labels.group}",
          "custom": { "lineWidth": 2, "showPoints": "never", "spanNulls": 600000 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "mean", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Luftfeuchte",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 10 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"humidity\" and r._field == \"value\")\n  |> filter(fn: (r) => r.group =~ /^${group:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"group\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "humidity",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "displayName": "${__field.labels.group}",
          "custom": { "lineWidth": 2, "showPoints": "never", "spanNulls": 600000 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "mean", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Geräteübersicht",
      "description": "Letzter Status aus iiot/group/+/status und letzte Messwerte je Gruppe (30 Tage).",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"device_status\" and r._field == \"status\")\n  |> last()\n  |> group()\n  |> keep(columns: [\"group\", \"_value\", \"_time\"])\n  |> rename(columns: {_value: \"Status\", _time: \"Letzte Statusmeldung\"})"
        },
        {
          "refId": "B",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and r._field == \"value\")\n  |> last()\n  |> group()\n  |> keep(columns: [\"group\", \"_value\", \"_time\"])\n  |> rename(columns: {_value: \"Letzte Temperatur\", _time: \"Letzter Messwert\"})"
        },
        {
          "refId": "C",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"humidity\" and r._field == \"value\")\n  |> last()\n  |> group()\n  |> keep(columns: [\"group\", \"_value\"])\n  |> rename(columns: {_value: \"Letzte Luftfeuchte\"})"
        }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "group", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "indexByName": { "group": 0, "Status": 1, "Letzte Statusmeldung": 2, "Letzte Temperatur": 3, "Letzte Luftfeuchte": 4, "Letzter Messwert": 5 },
            "renameByName": { "group": "Gruppe" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": { "color": "green", "index": 0 },
                      "error": { "color": "red", "index": 1 },
                      "offline": { "color": "orange", "index": 2 },
                      "unknown": { "color": "purple", "index": 3 }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "Letzte Statusmeldung|Letzter Messwert" },
            "properties": [{ "id": "unit", "value": "dateTimeFromNow" }]
          },
          {
            "matcher": { "id": "byName", "options": "Letzte Temperatur" },
            "properties": [
              { "id": "unit", "value": "celsius" },
              { "id": "decimals", "value": 1 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Letzte Luftfeuchte" },
            "properties": [
              { "id": "unit", "value": "humidity" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Gruppe", "desc": false }] }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Kennzahlen Temperatur (Zeitraum)",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 9 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "data = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and r._field == \"value\")\n  |> filter(fn: (r) => r.group =~ /^${group:regex}$/)\n\nunion(tables: [\n    data |> mean() |> set(key: \"_field\", value: \"Mittelwert\"),\n    data |> min() |> set(key: \"_field\", value: \"Minimum\"),\n    data |> max() |> set(key: \"_field\", value: \"Maximum\"),\n    data |> count() |> toFloat() |> set(key: \"_field\", value: \"Anzahl\"),\n])\n  |> keep(columns: [\"group\", \"_field\", \"_value\"])\n  |> pivot(rowKey: [\"group\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": { "group": 0, "Mittelwert": 1, "Minimum": 2, "Maximum": 3, "Anzahl": 4 },
            "renameByName": { "group": "Gruppe" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "celsius", "decimals": 1 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Anzahl" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Gruppe", "desc": false }] }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Kennzahlen Luftfeuchte (Zeitraum)",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 9 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "data = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"humidity\" and r._field == \"value\")\n  |> filter(fn: (r) => r.group =~ /^${group:regex}$/)\n\nunion(tables: [\n    data |> mean() |> set(key: \"_field\", value: \"Mittelwert\"),\n    data |> min() |> set(key: \"_field\", value: \"Minimum\"),\n    data |> max() |> set(key: \"_field\", value: \"Maximum\"),\n    data |> count() |> toFloat() |> set(key: \"_field\", value: \"Anzahl\"),\n])\n  |> keep(columns: [\"group\", \"_field\", \"_value\"])\n  |> pivot(rowKey: [\"group\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": { "group": 0, "Mittelwert": 1, "Minimum": 2, "Maximum": 3, "Anzahl": 4 },
            "renameByName": { "group": "Gruppe" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "humidity", "decimals": 1 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Anzahl" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Gruppe", "desc": false }] }
    },
    {
      "id": 8,
      "type": "state-timeline",
      "title": "Statusverlauf",
      "gridPos": { "x": 0, "y": 41, "w": 24, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"device_status\" and r._field == \"status\")\n  |> filter(fn: (r) => r.group =~ /^${group:regex}$/)\n  |> keep(columns: [\"_time\", \"_value\", \"group\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.group}",
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "ok": { "color": "green", "index": 0 },
                "error": { "color": "red", "index": 1 },
                "offline": { "color": "orange", "index": 2 },
                "unknown": { "color": "purple", "index": 3 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": { "showValue": "never", "mergeValues": true, "rowHeight": 0.8 }
    }
  ]
}
