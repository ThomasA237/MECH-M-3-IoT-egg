# Kopieren nach .env und Werte anpassen: cp .env.example .env
# Die .env steht in .gitignore und darf nicht committet werden.

# --- MQTT-Broker (siehe docs/iot-specs/conventions.md) ---
MQTT_HOST=
MQTT_PORT=
MQTT_USERNAME=
MQTT_PASSWORD=

# --- InfluxDB 2 (wird beim ersten Start automatisch eingerichtet) ---
INFLUX_USERNAME=admin
INFLUX_PASSWORD=
INFLUX_ORG=iiot
INFLUX_BUCKET=iiot
# Wie lange Messwerte aufbewahrt werden (z.B. 30d, 1w, 0 = unbegrenzt)
INFLUX_RETENTION=30d
# Beliebige lange Zufallszeichenkette, z.B. erzeugt mit: openssl rand -hex 32
INFLUX_TOKEN=

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
